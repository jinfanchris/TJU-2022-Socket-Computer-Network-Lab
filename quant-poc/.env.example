# Copy to `.env` and edit. All values are optional; defaults run offline.

# Where market data comes from: synthetic | csv | yfinance | ccxt
QUANT_DATA_MODE=synthetic

# Default instrument/timeframe when a request omits them.
QUANT_DEFAULT_SYMBOL=SYNTH
QUANT_DEFAULT_TIMEFRAME=1d

# Virtual account.
QUANT_STARTING_CASH=100000
QUANT_COMMISSION=0.0005

# CSV mode: folder containing <SYMBOL>.csv files.
QUANT_CSV_DIR=data/samples

# ccxt mode: which exchange to pull public OHLCV from.
QUANT_CCXT_EXCHANGE=binance
